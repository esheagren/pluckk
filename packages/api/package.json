{
  "name": "@pluckk/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "typecheck": "tsc --noEmit -p .",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:import": "dotenv -e .env.local -- tsx scripts/import-supabase.ts",
    "smoke": "dotenv -e .env.local -- tsx scripts/smoke.ts",
    "db:backfill": "dotenv -e .env.local -- tsx scripts/backfill-events.ts",
    "db:verify": "dotenv -e .env.local -- tsx scripts/verify-snapshots.ts",
    "smoke:mixer": "dotenv -e .env.local -- tsx scripts/smoke-mixer.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "@pluckk/core": "*",
    "@vercel/blob": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vercel/node": "^5.5.22",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12"
  }
}
